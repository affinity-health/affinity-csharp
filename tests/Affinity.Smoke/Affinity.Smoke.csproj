<Project Sdk="Microsoft.NET.Sdk">
  <!-- Written by hand. Runs the SDK against a real Affinity API in Test mode; see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="order-unknown-values.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Affinity\Affinity.csproj" />
  </ItemGroup>
</Project>
