<!-- Written by hand; scripts/generate.sh keeps it. Imported last by the generated Affinity.csproj. -->
<Project>
  <PropertyGroup>
    <!-- Fern also targets net9.0, which the .NET 8 SDK cannot build. The net8.0 build runs on .NET 9 and later. -->
    <TargetFrameworks>net462;net8.0;netstandard2.0</TargetFrameworks>
  </PropertyGroup>
</Project>
